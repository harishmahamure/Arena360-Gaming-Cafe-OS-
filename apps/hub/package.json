{
  "name": "@arena/hub",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "test:shell": "playwright test",
    "test:kitchen": "playwright test -c playwright.kitchen.config.ts",
    "bench:floor": "playwright test -c playwright.bench.config.ts floor-perf",
    "bench:flows": "playwright test -c playwright.bench.config.ts flow-timing",
    "bench:scanner": "playwright test -c playwright.bench.config.ts scanner --headed"
  },
  "dependencies": {
    "@arena/ui": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
