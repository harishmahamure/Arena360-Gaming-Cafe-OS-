---
import { t } from "@arena/ui";
import Layout from "../../layouts/Layout.astro";
import { legalDocs } from "../../lib/legal-content";
import { releaseDate } from "../../lib/releases";
import "../../styles/legal.css";

const docs = await legalDocs();
---

<Layout title={t("site.legal.title")} description={t("site.legal.description")}>
  <div class="legal">
    <header class="legal-intro">
      <h1>{t("site.legal.heading")}</h1>
      <p class="legal-lede">{t("site.legal.lede")}</p>
    </header>
    <ul class="legal-list" aria-label={t("site.legal.list")}>
      {docs.map((doc) => (
        <li data-slug={doc.slug}>
          <a href={`/legal/${doc.slug}`}>{doc.title}</a>
          <p>{doc.summary}</p>
          <p class="legal-meta">
            {t("site.legal.version", { version: doc.version })} ·{" "}
            {t("site.legal.effective", { date: releaseDate(doc.effective.toISOString()) })}
          </p>
        </li>
      ))}
    </ul>
  </div>
</Layout>
