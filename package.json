{
  "name": "arena-360",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build",
    "check:layers": "node scripts/check-layers.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:protocol": "node scripts/check-protocol-types.mjs",
    "check:strings": "node scripts/check-strings.mjs",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "check:tokens-fresh": "node scripts/check-tokens-fresh.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens-used": "node scripts/check-tokens-used.mjs",
    "check:hex": "node scripts/check-hex.mjs",
    "check:no-remote": "node scripts/check-no-remote.mjs",
    "check:no-blur": "node scripts/check-no-blur.mjs",
    "check:ads": "node scripts/check-ads.mjs source",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "check:play": "node scripts/play-release.mjs check",
    "check:farm": "node scripts/android-farm.mjs check",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format:check": "prettier --check .",
    "check:rust": "cargo fmt --check && cargo clippy --locked --workspace --all-targets -- -D warnings",
    "check": "pnpm run check:rust && pnpm run check:generated && pnpm run format:check && pnpm run check:layers && pnpm run check:pins && pnpm run check:protocol && pnpm run check:strings && pnpm run check:tokens-fresh && pnpm run check:contrast && pnpm run check:tokens-used && pnpm run check:hex && pnpm run check:no-blur && pnpm run check:ads && pnpm run check:secrets && pnpm run check:deploy && pnpm run check:play && pnpm run check:farm && pnpm run test:scripts"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "catalog:",
    "yaml": "2.9.1"
  }
}
